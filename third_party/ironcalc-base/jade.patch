+            .set_user_input(0, 5, 2, "=SUBTOTAL(109,A1:A3)".into())
+            .unwrap();
+        for uncertain in [false, true] {
+            with_visibility(
+                vec![SheetVisibility {
+                    overrides: HashMap::from([(2, true), (3, true)]),
