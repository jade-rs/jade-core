+pub(crate) fn three_d_qualifier(first_name: &str, last_name: &str) -> String {
+    if quote_name(first_name) == first_name && quote_name(last_name) == last_name {
+        format!("{first_name}:{last_name}")
+    } else {
+        format!(
+            "'{}:{}'",
+            first_name.replace('\'', "''"),
+            last_name.replace('\'', "''")
+        )
+    }
