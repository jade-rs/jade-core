+    #[test]
+    fn visibility_scopes_restore_nested_panics_and_leave_other_threads_and_model_rows_intact() {
+        let mut model = Model::new_empty("workbook", "en", "UTC", "en").unwrap();
+        model.set_row_hidden(0, 4, true).unwrap();
+        with_visibility(
+            vec![SheetVisibility {
