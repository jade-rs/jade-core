+    pub(super) fn digit_after_literals(&self, first: &Token) -> bool {
+        let literal_or_directive = |token: &Token| {
+            matches!(
+                token,
+                Token::Literal(_)
+                    | Token::Text(_)
+                    | Token::Ghost(_)
+                    | Token::Spacer(_)
+                    | Token::Color(_)
+                    | Token::Condition(_, _)
+                    | Token::Locale
+                    | Token::Currency(_)
+                    | Token::Percent
