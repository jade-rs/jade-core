+        assert_eq!(numberstring(123456, 1), "十二万三千四百五十六");
+        assert_eq!(numberstring(123456, 2), "壱拾弐萬参阡四百伍拾六");
+        assert_eq!(numberstring(100_000_000, 1), "一億");
+        assert_eq!(numberstring(1_010, 1), "千十");
+        assert_eq!(numberstring(0, 1), "〇");
+    }
