+        let mut model = new_empty_model();
+        model._set("A1", "=SUM(_xlfn.ANCHORARRAY(Z10))");
+        model._set("Z10", "=SEQUENCE(3)");
+        model.evaluate();
+        assert_eq!(model._get_text("A1"), "6");
+    }
+}
