+        (" 2 ", [false, true, false]),
+        ("= +2E0 ", [false, true, false]),
+    ] {
+        let criterion = CalcResult::String(text.into());
+        let matches = build_criteria(&criterion, en_locale());
+        for (number, expected) in [1.0, 2.0, 3.0].into_iter().zip(expected) {
+            assert_eq!(
+                matches(&CalcResult::Number(number)),
+                expected,
+                "{text}: {number}"
+            );
+        }
+    }
+}
